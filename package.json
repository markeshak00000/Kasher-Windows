{
  "name": "kasher-windows",
  "version": "1.0.0",
  "description": "Kasher Windows App",
  "author": "markeshak00000",
  "main": "main.js",
  "scripts": {
    "build:win": "electron-builder --win --x64 --publish never"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.kasher.app",
    "productName": "Kasher",
    "files": ["**/*", "!**/.github/**"],
    "publish": null,
    "win": {
      "target": "nsis"
    }
  }
}
